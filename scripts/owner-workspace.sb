(version 1)
(deny default)
(import "system.sb")
(allow file-read-metadata)
(allow process-exec process-fork sysctl-read)
(allow file-read* (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/Library/Developer") (subpath "/private/var/db/dyld") (subpath "/opt/homebrew/Cellar") (subpath "/opt/homebrew/bin") (subpath "/opt/homebrew/lib") (literal "/dev/null") (subpath (param "WORK")) (subpath (param "TMP")))
(allow file-write* (literal "/dev/null") (subpath (param "WORK")) (subpath (param "TMP")))
(deny file-write* (regex #"/[.](git|claude|codex|agents)(/|$)"))
(deny file-read* (regex #"/[.](private|env)([./]|$)") (regex #"/[.]claude/worktrees(/|$)"))
(deny network*)
